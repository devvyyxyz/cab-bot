# Discord bot credentials — get these from https://discord.com/developers/applications
# 1. Create an application → "Bot" tab → "Reset Token" to get DISCORD_TOKEN.
# 2. On the "General Information" tab, copy the "App ID" → DISCORD_CLIENT_ID.
# 3. Under "OAuth2 → Privileged Gateway Intents", enable:
#    - MESSAGE CONTENT INTENT (required for the spawn catch system)

DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here

# Optional: set PORT or HEALTH_CHECK_PORT to enable the HTTP health check endpoint
# (useful for hosting platforms like Railway, Render, Fly.io).
# PORT=3000

# Optional: set LOG_LEVEL=debug for verbose output (default: info).
# LOG_LEVEL=info

# Optional: set DB_PATH to override the SQLite database file location.
# Defaults to ./data/brainrot.db
# DB_PATH=/path/to/brainrot.db
