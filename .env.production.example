# Production / public bot credentials
# Copy this file to .env.production and paste your public bot's token + client ID.
# Loaded automatically when NODE_ENV=production

DISCORD_TOKEN=your-prod-bot-token-here
DISCORD_CLIENT_ID=your-prod-app-id-here

# Roblox API key (optional but recommended for username resolution).
# Get one at https://create.roblox.com/docs/apis/authentication
ROBLOX_API_KEY=your-roblox-api-key-here
