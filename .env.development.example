# Development bot credentials
# Copy this file to .env.development and paste your dev bot's token + client ID.
# Loaded automatically when NODE_ENV=development

DISCORD_TOKEN=your-dev-bot-token-here
DISCORD_CLIENT_ID=your-dev-app-id-here

# Roblox API key (optional but recommended for username resolution).
# Get one at https://create.roblox.com/docs/apis/authentication
ROBLOX_API_KEY=your-roblox-api-key-here
